# GitHub Ingress & Egress
GITHUB_WEBHOOK_SECRET=your_hmac_webhook_secret
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./certs/github-private-key.pem
# Fine-grained PAT: Pull requests Read/Write + Contents Read. Required for live reviews.
GITHUB_TOKEN=ghp_fallback_personal_access_token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=30

# Unified Data Spine (Tiger Cloud / TimescaleDB + pgvectorscale)
TIGER_DATABASE_URL=postgresql://user:password@host:port/tsdb?sslmode=require
# Use a file path (e.g. ./data/pr_reviewer.sqlite) to persist findings across jobs.
SPINE_SQLITE_PATH=:memory:

# Queue & Checkpointing (Upstash / Redis)
REDIS_URL=rediss://default:password@host:port
# memory: in-process only (tests/dry runs). redis: webhook -> ARQ worker.
QUEUE_BACKEND=memory

# Keep large/vendored PRs within the LLM budget. Source files are prioritized.
MAX_REVIEW_DIFF_BYTES=120000
MAX_REVIEW_FILE_BYTES=40000

# LLM Providers & Embeddings
# deterministic (default, offline) or gemini (live generateContent calls)
LLM_PROVIDER=deterministic
GEMINI_API_KEY=...
GEMINI_MODEL_HIGH=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# deterministic (default, feature hashing, offline) or gemini (Gemini Embedding 2)
EMBEDDING_PROVIDER=deterministic
# Use gemini-embedding-2 when EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Legacy/unused provider keys kept for contract compatibility
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Autonomy, Selectivity & Economics Guards
CONFIDENCE_THRESHOLD=0.75
DAILY_BUDGET_USD=10.00
NODE_TIMEOUT_SECONDS=60
# Single-PR summary comment: post the whole review as one structured
# conversation comment instead of one inline comment per finding.
POST_PR_SUMMARY_COMMENT=false
# Clean-PR comment (default true): even with zero findings, post a short
# "all clear" summary so every reviewed PR shows a verdict. Set false for
# silent clean PRs.
POST_CLEAN_COMMENT=true

# Dashboard (frontend): where the ingress API lives. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
